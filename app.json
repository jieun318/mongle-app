{
  "expo": {
    "name": "mongle",
    "slug": "mongle",
    "scheme": "mongle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEE8F8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mongle.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EEE8F8"
      },
      "package": "com.mongle.app"
    },
    "plugins": ["expo-router"]
  }
}
