{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "expo export -p web",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/keepalive",
      "schedule": "0 18 * * *"
    }
  ]
}
