EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 시드 스크립트(supabase/scripts/seed_dreams.mjs) 전용 — 클라이언트에 노출 금지
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 서버 전용 (Vercel 환경변수) — EXPO_PUBLIC_ 접두사 붙이면 앱 번들에 노출되니 금지
# AI 챗봇 (api/chat.ts)
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# 기상청 초단기실황 (api/weather.ts) — data.go.kr 활용신청 '일반 인증키(Encoding)'
# 미설정 시 /api/weather 가 조용히 {"condition":"clear","reason":"no_key"} 를 반환한다
KMA_SERVICE_KEY=your-kma-service-key
