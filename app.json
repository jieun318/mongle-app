{
  "expo": {
    "name": "mongle",
    "slug": "mongle",
    "scheme": "mongle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mongle.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#BCACEC"
      },
      "package": "com.mongle.app",
      "permissions": ["android.permission.ACCESS_COARSE_LOCATION"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "//": "네이티브 콜드스타트 스플래시는 배경색만 보이게 한다(투명 아이콘). Android 12+ 는 아이콘을 완전히 뺄 수 없어 투명 PNG 로 대체 → 배경색 #F8F3FF 만 잠깐 보이다가 커스텀 스플래시(구슬)로 이어짐.",
          "image": "./assets/images/splash-transparent.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F3FF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진을 등록하기 위해 사진 라이브러리 접근이 필요해요.",
          "cameraPermission": "프로필 사진을 촬영하기 위해 카메라 접근이 필요해요."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#7868C8"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "현재 위치의 날씨(비/눈)와 해 위치를 홈 화면에 반영하기 위해 위치 정보를 사용해요.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "./plugins/withCoarseLocationOnly.js"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "76bbf748-44bf-4f6f-81d3-3c59602f1320"
      }
    }
  }
}
