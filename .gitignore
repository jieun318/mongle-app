# dependencies
node_modules/

# 패키지 매니저는 npm 으로 통일 — pnpm/yarn lockfile 은 추적하지 않음
pnpm-lock.yaml
yarn.lock

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# 아이콘/스플래시 생성 미리보기 PNG (스크립트는 보관)
assets/_preview/*.png
