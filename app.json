{
  "expo": {
    "name": "mongle",
    "slug": "mongle",
    "scheme": "mongle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/appicon.png",
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#9888CC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mongle.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#B0A0DD"
      },
      "package": "com.mongle.app",
      "permissions": []
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진을 등록하기 위해 사진 라이브러리 접근이 필요해요.",
          "cameraPermission": "프로필 사진을 촬영하기 위해 카메라 접근이 필요해요."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#7868C8"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "76bbf748-44bf-4f6f-81d3-3c59602f1320"
      }
    }
  }
}
