# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# 패키지 매니저는 npm 으로 통일 — pnpm/yarn lockfile 은 추적하지 않음
pnpm-lock.yaml
yarn.lock

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Vercel CLI 링크 정보
.vercel/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# 아이콘/스플래시 생성 미리보기 PNG (스크립트는 보관)
assets/_preview/*.png

# 피처 그래픽 생성 중간산출물 (폰트 인라인이라 ~3MB) — 최종 PNG 만 추적
assets/store/feature-graphic.html
assets/store/raw.png

# 폰에서 찍은 원본 스크린샷 — 후처리된 최종본만 추적
assets/store/screenshots/raw/*
!assets/store/screenshots/raw/.gitkeep

# 개인 문서 (사업자등록증명 등) — 앱 자산 아님, repo 밖 보관
*.brl
/_private/

# 배포용 비밀키 (Play 서비스 계정 JSON 등) — eas.json submit 참고
/secrets/
