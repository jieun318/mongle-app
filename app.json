{
  "expo": {
    "name": "mongle",
    "slug": "mongle",
    "scheme": "mongle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEE8F8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mongle.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EEE8F8"
      },
      "package": "com.mongle.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "프로필 사진을 등록하기 위해 사진 라이브러리 접근이 필요해요.",
          "cameraPermission": "프로필 사진을 촬영하기 위해 카메라 접근이 필요해요."
        }
      ]
    ]
  }
}
